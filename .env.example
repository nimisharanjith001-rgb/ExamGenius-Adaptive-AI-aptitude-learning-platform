# Environment Variables for PowerPulse AI
PROJECT_NAME="PowerPulse AI"
API_V1_STR="/api"
SECRET_KEY="powerpulse_secret_key_change_in_production_jwt_tokens"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./powerpulse.db"

# Storage
DATASET_STORAGE_DIR="./datasets"
MODEL_STORAGE_DIR="./trained_models"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

